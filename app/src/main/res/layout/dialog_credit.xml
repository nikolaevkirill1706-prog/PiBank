<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <EditText
        android:id="@+id/etAmount"
        style="@style/PiInput"
        android:hint="Сумма кредита (от 100 до 100 000)"
        android:importantForAutofill="no"
        android:inputType="numberDecimal" />

    <Spinner
        android:id="@+id/spTerm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Верните кредит до конца срока. После срока долг удваивается. Если не погасить его ещё 3 дня, все ваши карты, включая детские, будут удалены."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
</LinearLayout>
